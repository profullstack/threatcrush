{
  "name": "@profullstack/threatcrush",
  "version": "0.13.50",
  "description": "All-in-one security agent daemon — monitor, detect, scan, and protect servers in real-time",
  "bin": {
    "threatcrush": "./dist/index.js"
  },
  "engines": {
    "node": ">=22.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "crs:build": "node scripts/build-crs-rules.mjs",
    "libinjection:build": "node scripts/build-libinjection-wasm.mjs"
  },
  "keywords": [
    "security",
    "monitoring",
    "threat-detection",
    "pentest",
    "scanner",
    "daemon",
    "cli",
    "cybersecurity"
  ],
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/systemd/*.service",
    "dist/crs/LICENSE",
    "dist/crs/NOTICE",
    "dist/libinjection/libinjection.wasm",
    "dist/libinjection/COPYING",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@profullstack/hqtui": "^0.11.0",
    "@sentry/node": "^11.9.0",
    "better-sqlite3": "^13.0.3",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "nodemailer": "^10.2.1",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@threatcrush/attack-map": "workspace:*",
    "@threatcrush/scan": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/profullstack/threatcrush.git",
    "directory": "apps/cli"
  },
  "homepage": "https://threatcrush.com",
  "bugs": {
    "url": "https://github.com/profullstack/threatcrush/issues"
  },
  "author": "Profullstack, Inc. <hello@profullstack.com>"
}
