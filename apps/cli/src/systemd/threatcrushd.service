[Unit]
Description=ThreatCrush Security Agent Daemon
Documentation=https://threatcrush.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The path to the CLI binary is filled in by `threatcrush install-service`.
ExecStart={{BIN_PATH}} daemon
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10

# Security hardening — adjust as needed
NoNewPrivileges=true
ProtectSystem=full
# ProtectHome is read-only, but the daemon must write its own cloud session
# dir (it rotates and re-saves the access/refresh token on every refresh).
# {{CONFIG_DIR}} is the daemon user's ~/.threatcrush, punched back to writable
# here by `threatcrush install-service`. Without it the token refresh hit
# EROFS, the heartbeat stopped, and every server showed offline after an hour.
ProtectHome=read-only
ReadWritePaths=/etc/threatcrush /var/log/threatcrush /var/lib/threatcrush {{CONFIG_DIR}}
# /var/run is a symlink to /run, which is a tmpfs — anything created there at
# install time is gone after the next reboot. Listing it under ReadWritePaths
# then makes the unit fail 226/NAMESPACE on every start. RuntimeDirectory has
# systemd create (and clean up) /run/threatcrush itself, on each start.
RuntimeDirectory=threatcrush
RuntimeDirectoryMode=0755
PrivateTmp=true

# Log directly to journald
StandardOutput=journal
StandardError=journal

# Capabilities the daemon actually needs:
#   CAP_NET_RAW / CAP_NET_ADMIN — raw packet capture for network-monitor module
#   CAP_DAC_READ_SEARCH         — read mode-640 logs (auth.log, syslog, nginx) the
#                                 daemon doesn't own without falling back to mode 666
#   CAP_DAC_OVERRIDE            — same idea for the rare write that needs it
#   CAP_CHOWN                   — chgrp the IPC socket to `adm` so non-root
#                                 users in that group can talk to the daemon
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_CHOWN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_CHOWN


[Install]
WantedBy=multi-user.target
