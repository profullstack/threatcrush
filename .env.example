# Every environment variable the web app (apps/web) reads. Copy to .env
# (docker compose) or apps/web/.env.local (next dev). Placeholders only.
# Commented-out variables either have a default or must be unset rather than
# empty (their code takes "" as a value): uncomment them only to set a value.

# ─── Required: Supabase ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Required: App ───
# Public base URL, used in emails, redirects, payment callbacks and alert links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Encrypts per-org secrets at rest. 32 bytes, base64: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=base64-encoded-32-byte-key
# Fallback for NEXT_PUBLIC_APP_URL in the CoinPay client only.
# APP_URL=
# HMAC key for the short-lived signup grant cookie. Unset = derived from
# SUPABASE_SERVICE_ROLE_KEY. Generate with: openssl rand -hex 32
SIGNUP_GRANT_SECRET=

# ─── Optional: Email (Resend) ───
# Whitepaper and checklist mail, the contact form, and email alert destinations.
RESEND_API_KEY=

# ─── Optional: Contact form guard ───
# Signs contact-form tokens. Unset = falls back to RESEND_API_KEY.
# FORM_GUARD_SECRET=
# 0 = score submissions without blocking them. Anything else (or unset) blocks.
# FORM_GUARD_ENFORCE=1

# ─── Optional: SMS phone verification (Telnyx via Supabase Send SMS hook) ───
TELNYX_API_KEY=
# Sender number in E.164, e.g. +15551234567.
TELNYX_PHONE_NUMBER=
# The Send SMS hook secret from Supabase (Auth → Hooks), "v1,whsec_..." form.
# Unset = every hook call is rejected.
SUPABASE_SMS_HOOK_SECRET=

# ─── Optional: Payments (CoinPayPortal) ───
COINPAYPORTAL_API_KEY=
COINPAYPORTAL_BUSINESS_ID=
# COINPAYPORTAL_API_URL=https://coinpayportal.com
# Verifies CoinPay webhook signatures.
COINPAY_WEBHOOK_SECRET=
# "true" enables AI-credit top-ups; unset or anything else keeps them paused.
USAGE_TOPUPS_ENABLED=

# ─── Optional: Crawl gateway (@profullstack/x402-gateway) ───
# AI training crawlers pay $1/day over x402. A SCOPED CoinPay key
# (payments:create) and the EVM address that receives the USDC. Unset =
# crawlers still get 402, nothing sold.
COINPAY_X402_KEY=
CRAWL_PAY_TO=
# Site URL the gateway advertises. Defaults to https://threatcrush.com.
# SITE_URL=
# NEXT_PUBLIC_SITE_URL=

# ─── Optional: GitHub App (repo scans on install/push) ───
GITHUB_APP_ID=
# PEM with real newlines, PEM with literal \n, or base64 of the whole PEM.
GITHUB_APP_PRIVATE_KEY=
# The App's webhook secret (developer settings → Webhook).
GITHUB_APP_WEBHOOK_SECRET=

# ─── Optional: GitHub Marketplace listing webhook ───
# Set on the listing's Webhook page (Payload URL + Secret), not in the App's
# developer settings. Must match the Secret field byte for byte.
# Generate with: openssl rand -hex 32
GITHUB_MARKETPLACE_WEBHOOK_SECRET=

# ─── Optional: Push notifications ───
# Web Push (PWA). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@threatcrush.com
# Mobile (Expo). Only needed if "Enhanced push security" is on for the project.
# EXPO_ACCESS_TOKEN=

# ─── Optional: AI ───
# Quality gate for posts syndicated in through the crawlproof webhook.
# ANTHROPIC_API_KEY=
# Writes marketplace module descriptions when a listing's own is too short.
OPENAI_API_KEY=

# ─── Optional: Blog ───
# WebSub hub pinged on new posts. Defaults to https://pubsubhubbub.appspot.com/
# WEBSUB_HUB=

# ─── Optional: Error reporting (Sentry) ───
# Server-side route errors are sent here. Unset = the SDK is never loaded and
# nothing leaves the process. Browser errors are not reported.
SENTRY_DSN=
# Release name attached to reported errors, e.g. the deployed git SHA.
# SENTRY_RELEASE=

# ─── Self-Hosting ───
# PORT=3000
# NODE_ENV=production
# Reverse proxies in front of the app that append the peer address to
# X-Forwarded-For (nginx: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;).
# The rate limiter keys on the Nth X-Forwarded-For entry from the right, since
# anything to its left was sent by the client. Default 1 = a single nginx.
# TRUSTED_PROXY_HOPS=1
