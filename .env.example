# ─── Required: Supabase ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: "Continue with GitHub" on login/signup. Enable the GitHub provider
# in Supabase Auth first, then set to true (read at build time).
NEXT_PUBLIC_GITHUB_OAUTH_ENABLED=

# ─── Required: App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
SETTINGS_ENCRYPTION_KEY=base64-encoded-32-byte-key

# ─── Optional: Payments (CoinPay) ───
# Card payments also go through CoinPay; there is no direct Stripe integration.
COINPAYPORTAL_API_KEY=cp_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COINPAYPORTAL_BUSINESS_ID=00000000-0000-0000-0000-000000000000
COINPAY_WEBHOOK_SECRET=whsecret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COINPAYPORTAL_API_URL=https://coinpayportal.com
# AI usage-credit top-ups (/usage) stay paused unless this is exactly "true".
USAGE_TOPUPS_ENABLED=

# --- Optional: GitHub Marketplace listing webhook ---
# Set on the listing's Webhook page (Payload URL + Secret), not in the App's
# developer settings. Must match the Secret field byte for byte.
# Generate with: openssl rand -hex 32
GITHUB_MARKETPLACE_WEBHOOK_SECRET=

# ─── Optional: Web Push (VAPID keys for PWA push notifications) ───
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@threatcrush.com

# ─── Optional: AI Deep Scan ───
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Self-Hosting ───
# PORT=3000
# NODE_ENV=production
# Reverse proxies in front of the app that append the peer address to
# X-Forwarded-For (nginx: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;).
# The rate limiter keys on the Nth X-Forwarded-For entry from the right, since
# anything to its left was sent by the client. Default 1 = a single nginx.
# TRUSTED_PROXY_HOPS=1

# Crawl gateway (@profullstack/x402-gateway): AI training crawlers pay $1/day over
# x402. A SCOPED CoinPay key (payments:create) and the EVM address that receives
# the USDC. Unset = crawlers still get 402, nothing sold.
COINPAY_X402_KEY=
CRAWL_PAY_TO=
