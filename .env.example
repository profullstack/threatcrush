# ─── Required: Supabase ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Required: App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
SETTINGS_ENCRYPTION_KEY=base64-encoded-32-byte-key

# ─── Optional: Payments (Stripe) ───
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# ─── Optional: Payments (CoinPay) ───
COINPAY_API_KEY=cp_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COINPAY_BUSINESS_ID=00000000-0000-0000-0000-000000000000
COINPAY_WEBHOOK_SECRET=whsecret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COINPAY_API_URL=https://coinpayportal.com

# --- Optional: GitHub Marketplace listing webhook ---
# Set on the listing's Webhook page (Payload URL + Secret), not in the App's
# developer settings. Must match the Secret field byte for byte.
# Generate with: openssl rand -hex 32
GITHUB_MARKETPLACE_WEBHOOK_SECRET=

# ─── Optional: Web Push (VAPID keys for PWA push notifications) ───
# Used by the "Browser notifications" control on /org/<slug>/settings/alerts and
# by Push alert destinations. Generate the pair once, keep it stable (rotating
# it invalidates every browser subscription):
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is inlined into the browser bundle at build time
# and also read by the server. Unset = browser notifications show "not configured"
# and web-push deliveries are recorded as failed.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@threatcrush.com

# ─── Optional: Alert delivery providers ───
# Email alert destinations send through Resend from alerts@threatcrush.com.
# Unset = email deliveries are recorded as failed.
RESEND_API_KEY=
# Mobile-app push goes through Expo's push service. Only needed when
# "Enhanced push security" is enabled for the Expo project.
EXPO_ACCESS_TOKEN=

# ─── Optional: AI Deep Scan ───
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Self-Hosting ───
# PORT=3000
# NODE_ENV=production

# Crawl gateway (@profullstack/x402-gateway): AI training crawlers pay $1/day over
# x402. A SCOPED CoinPay key (payments:create) and the EVM address that receives
# the USDC. Unset = crawlers still get 402, nothing sold.
COINPAY_X402_KEY=
CRAWL_PAY_TO=
